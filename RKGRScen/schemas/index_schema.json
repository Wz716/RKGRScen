{
  "_comment": "LLM_index output schema (community_tagger.output_schema). The enum is sourced from RKGRScen/config/violation_map.json keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "applicable_violations"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "applicable_violations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Inattention to the road ahead",
          "Failure to yield",
          "Speeding",
          "Failure to maintain safe following distance",
          "Wrong-way driving",
          "Illegal lane change",
          "Illegal overtaking"
        ]
      }
    }
  }
}
