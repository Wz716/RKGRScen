{
  "_comment": "LLM_index output schema (community_tagger.output_schema). The enum is sourced from RKGRScen/config/violation_map.json keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "applicable_violations"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "applicable_violations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "超速行驶",
          "闯红灯",
          "逆行",
          "违法占用应急车道",
          "违反交通信号(其他)",
          "违规变道",
          "违规超车",
          "违规掉头",
          "未按规定让行",
          "未保持安全距离",
          "未注意前方路况"
        ]
      }
    }
  }
}
