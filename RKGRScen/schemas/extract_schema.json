{
  "_comment": "LLM_extract output schema (scenario_extractor.output_schema). Maps to the logical scenario four-tuple L = (V_type, A, R_req, E_cond): violation_type -> V_type, dsl.actors -> A, dsl.road_network -> R_req, dsl.env -> E_cond. The violation_type enum is sourced from RKGRScen/config/violation_map.json keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["violation_type", "likelihood", "reason", "law", "dsl"],
  "properties": {
    "violation_type": {
      "type": "string",
      "enum": [
        "Inattention to the road ahead",
        "Failure to yield",
        "Speeding",
        "Failure to maintain safe following distance",
        "Wrong-way driving",
        "Illegal lane change",
        "Illegal overtaking"
      ]
    },
    "likelihood": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "违规可能性评分（1-5）"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "判断依据（行为 oracle 的因果/时序描述）"
    },
    "law": {
      "type": "string",
      "minLength": 1,
      "description": "法规依据"
    },
    "dsl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["road_network", "actors", "env"],
      "properties": {
        "road_network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "lanes"],
          "properties": {
            "type": {"type": "string"},
            "lanes": {"type": "integer", "minimum": 1},
            "stem_direction": {"type": "string"}
          }
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "initial_position", "actions", "speed_limit"],
            "properties": {
              "model": {"type": "string"},
              "initial_position": {"type": "string"},
              "actions": {"type": "string"},
              "speed_limit": {"type": "number"}
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time", "weather"],
          "properties": {
            "time": {"type": "string"},
            "weather": {"type": "string"}
          }
        }
      }
    }
  }
}
